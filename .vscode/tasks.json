{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "preset": "debug",
      "targets": [
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template build task"
    },
    {
      "type": "cmake",
      "label": "CMake: clean",
      "command": "clean",
      "preset": "debug",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template clean task"
    },
    {
      "type": "cmake",
      "label": "CMake: configure",
      "command": "configure",
      "preset": "debug",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template configure task"
    },
    {
      "type": "shell",
      "label": "Flash (LinkServer)",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\flash-linkserver.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build + Flash (LinkServer)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: configure",
        "CMake: build",
        "Flash (LinkServer)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean + Build + Flash (LinkServer)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: clean",
        "CMake: configure",
        "CMake: build",
        "Flash (LinkServer)"
      ],
      "problemMatcher": []
    }
  ]
}